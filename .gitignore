From f9181e183a52f29413e3ed540db71c6d57da657f Mon Sep 17 00:00:00 2001
From: netaudio contributor <contributor@example.invalid>
Date: Thu, 5 Nov 2026 17:57:34 +0000
Subject: [PATCH] Ignore local environments, IDE files, OS metadata and packet
 captures

---
 .gitignore | 40 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/.gitignore b/.gitignore
index 3a26c8f..ce79eb3 100644
--- a/.gitignore
+++ b/.gitignore
@@ -29,3 +29,43 @@ packages/netaudio/src/netaudio/_build_info.json
 containers/.env
 
 !packages/netaudio-daemon/src/capture/schema.sql
+
+# ---------------------------------------------------------------------------
+# Fork additions. Kept below the upstream entries so rebases merge cleanly.
+# ---------------------------------------------------------------------------
+
+# Python environments, packaging and tool caches
+.venv/
+venv/
+*.egg-info/
+.pytest_cache/
+.ruff_cache/
+.mypy_cache/
+.coverage
+.coverage.*
+htmlcov/
+
+# Rust editor backups
+**/*.rs.bk
+
+# IDEs and editors
+.idea/
+*.iml
+.vscode/
+.fleet/
+.zed/
+*~
+*.kate-swp
+
+# Desktop and OS metadata
+.directory
+.DS_Store
+Thumbs.db
+
+# Local secrets and environment overrides
+.env
+.env.*
+
+# Packet captures can contain private network details
+*.pcap
+*.pcapng
-- 
2.43.0